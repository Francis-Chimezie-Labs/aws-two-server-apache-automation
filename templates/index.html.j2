<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Francis C. Osondu | {{ inventory_hostname }}</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .card {
            background: white;
            padding: 50px;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.1);
            text-align: center;
            max-width: 700px;
            width: 90%;
        }

        h1 {
            font-size: 42px;
            margin-bottom: 5px;
        }

        h2 {
            margin-top: 5px;
        }

        .project {
            font-size: 20px;
            margin-bottom: 30px;
        }

        .status {
            font-weight: bold;
            margin: 25px 0;
        }

        .details {
            line-height: 1.9;
        }

        footer {
            margin-top: 35px;
            font-size: 14px;
        }
    </style>
</head>

<body>
    <div class="card">

        <h1>Francis C. Osondu</h1>

        <p class="project">
            Cloud & DevOps Automation Project
        </p>

        <h2>{{ inventory_hostname }}</h2>

        <p class="status">
            Apache Web Server Successfully Deployed
        </p>

        <div class="details">
            <p>
                <strong>Private IP:</strong>
                {{ ansible_default_ipv4.address }}
            </p>

            <p>
                <strong>AWS Region:</strong>
                us-east-2 (Ohio)
            </p>

            <p>
                <strong>Operating System:</strong>
                Ubuntu 24.04 LTS
            </p>

            <p>
                <strong>Web Server:</strong>
                Apache
            </p>

            <p>
                <strong>Infrastructure:</strong>
                AWS EC2
            </p>

            <p>
                <strong>Provisioning:</strong>
                Terraform
            </p>

            <p>
                <strong>Configuration Management:</strong>
                Ansible
            </p>
        </div>

        <footer>
            Designed and automated by Francis C. Osondu
        </footer>

    </div>
</body>
</html>